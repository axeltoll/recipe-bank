# https://editorconfig.org — the style the repository already uses.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces can be a line break in Markdown.
trim_trailing_whitespace = false

[recipes/*.json]
# Recipe files are two-space JSON with a trailing newline (lib/draft.mjs formatRecipe, the server and migrate).
indent_size = 2
insert_final_newline = true
